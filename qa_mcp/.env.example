MCP_QA_AZURE_DEVOPS_BASE_URL=https://dev.azure.com/bigviewmanagement
MCP_QA_AZURE_DEVOPS_API_VERSION=7.1
MCP_QA_TRANSPORT=streamable-http
MCP_QA_TENANT_ID=fc03ac75-42c6-440a-becf-d343156b3b74
# TOKEN_AUDIENCES_CSV defaults to the Azure DevOps resource ID (499b84ac-1321-427f-aa17-267ca6975798).
# Override only if you have a dedicated Entra ID App Registration for this MCP server.
# MCP_QA_TOKEN_AUDIENCES_CSV=api://replace-with-mcp-app-id-uri
# Permisos por herramienta: SOLO aplica si tienes una App Registration dedicada con app-roles.
# Con el token normal de Azure DevOps (az account get-access-token) NO existen esos roles,
# por lo que debe quedar vacio/comentado o bloqueara todas las herramientas.
# MCP_QA_TOOL_PERMISSIONS_JSON={"collect_plan_data":["qa.test.read"],"collect_documentation_data":["qa.test.read"],"link_bug_template":["qa.bug.write"]}
# Nombre del Key Vault para secretos sensibles como client secrets o certificados.
# MCP_QA_KEY_VAULT_NAME=mi-keyvault-qa
# O, si prefieres, la URL completa:
# MCP_QA_KEY_VAULT_URL=https://mi-keyvault-qa.vault.azure.net/
MCP_QA_REQUEST_TIMEOUT_SECONDS=30
