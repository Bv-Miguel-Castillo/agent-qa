# Azure AD (Entra ID) tenant GUID, ej:
AZURE_TENANT_ID=a1b2c3d4-e5f6-4a7b-8c9d-1234567890ab

# Client ID que lee los secretos de Key Vault: en local, el de tu App Registration; en produccion, el de la Managed Identity
AZURE_CLIENT_ID=9f8e7d6c-5b4a-4321-9c8d-abcdef123456

# Solo para desarrollo local con client secret. Dejar vacio en produccion (usa Managed Identity en su lugar)
AZURE_CLIENT_SECRET=changeme-client-secret

# Resource/App ID de Azure DevOps para el scope OAuth, ej:
AZURE_DEVOPS_RESOURCE_ID=499b84ac-1321-427f-aa17-267ca6975798

# Nombre del Key Vault en Azure, ej: kv-mi-proyecto-dev
KEY_VAULT_NAME=kv-mi-proyecto-dev

# URL de tu organizacion en Azure DevOps, ej:
AZURE_DEVOPS_ORGANIZATION=https://dev.azure.com/mi-organizacion

# Modo de transporte del servidor MCP: streamable-http | stdio
TRANSPORT=streamable-http
